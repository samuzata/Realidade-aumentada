<!DOCTYPE html>
<html lang="pt-BR">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">

  <title>Teste de Realidade Aumentada</title>

  <!-- Biblioteca 3D -->
  <script src="https://aframe.io/releases/1.6.0/aframe.min.js"></script>

  <!-- Biblioteca de realidade aumentada -->
  <script src="https://raw.githack.com/AR-js-org/AR.js/3.4.8/aframe/build/aframe-ar.js"></script>

  <style>
    body {
      margin: 0;
      overflow: hidden;
      font-family: Arial, sans-serif;
    }

    #status {
      position: fixed;
      top: 12px;
      left: 12px;
      z-index: 10;
      padding: 10px 14px;
      background: rgba(0, 0, 0, 0.75);
      color: white;
      border-radius: 8px;
      font-size: 14px;
    }
  </style>
</head>

<body>

  <div id="status">Procurando marcador Hiro...</div>

  <a-scene
    embedded
    vr-mode-ui="enabled: false"
    renderer="antialias: false; colorManagement: true"
    arjs="
      sourceType: webcam;
      trackingMethod: best;
      detectionMode: mono;
      debugUIEnabled: false;
    "
  >

    <!-- Marcador Hiro -->
    <a-marker
      preset="kanji"
      id="marcador"
      emitevents="true"
    >

      <!-- Objeto virtual -->
      
<!-- Objeto virtual: esfera -->
<a-sphere
  position="0 0.5 0"
  radius="0.2"
  color="#0000FF"
  material="shader: flat"
>
</a-sphere>


    </a-marker>

    <!-- CÃ¢mera -->
    <a-entity camera></a-entity>

  </a-scene>

  <script>
    const marcador = document.getElementById("marcador");
    const status = document.getElementById("status");

    marcador.addEventListener("markerFound", () => {
      status.textContent = "Marcador reconhecido!";
      status.style.background = "rgba(0, 120, 40, 0.85)";
    });

    marcador.addEventListener("markerLost", () => {
      status.textContent = "Procurando marcador Hiro...";
      status.style.background = "rgba(0, 0, 0, 0.75)";
    });
  </script>

</body>
</html>
